# ==============================================================================
# FRONTEND CONFIGURATION (Public client-side Vite environment variables)
# Exposed to the browser - do NOT store secret keys or private credentials here.
# ==============================================================================

# Core Firebase Web App Configuration (itissimple-security-staging)
VITE_FIREBASE_API_KEY=your-firebase-api-key-placeholder
VITE_FIREBASE_AUTH_DOMAIN=itissimple-security-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=itissimple-security-staging
VITE_FIREBASE_STORAGE_BUCKET=itissimple-security-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id-placeholder
VITE_FIREBASE_APP_ID=your-firebase-web-app-id-placeholder

# Additional Frontend Firebase & OAuth Settings
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_OAUTH_CLIENT_ID=your-oauth-client-id-placeholder.apps.googleusercontent.com

# ==============================================================================
# BACKEND CONFIGURATION (Private server-side Node.js / Express environment)
# Never expose these variables to the frontend or browser bundles.
# ==============================================================================

# Firebase Project Identifier
FIREBASE_PROJECT_ID=itissimple-security-staging

# Backend Firestore & Client Configuration
FIREBASE_API_KEY=your-firebase-api-key-placeholder
FIREBASE_AUTH_DOMAIN=itissimple-security-staging.firebaseapp.com
FIREBASE_DATABASE_ID=(default)

# ------------------------------------------------------------------------------
# Backend Authentication Options for Firebase Admin SDK:
# Option 1: Application Default Credentials (ADC)
#   - On Google Cloud / Cloud Run: resolved automatically by the runtime environment.
#   - Locally or outside GCP: point GOOGLE_APPLICATION_CREDENTIALS to the service account JSON file path.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# Option 2: Service Account Environment Variables (Direct Injection)
#   - Alternative when mounting credential files is not possible.
# FIREBASE_CLIENT_EMAIL=your-service-account@itissimple-security-staging.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ------------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
FIREBASE_CLIENT_EMAIL=your-service-account@itissimple-security-staging.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# EXTERNAL INTEGRATIONS & APIS (Backend / Server-side)
# ==============================================================================

# Gemini AI API
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-2.5-flash

# Google APIs & Google Drive Integration
GOOGLE_CLIENT_ID=your-google-client-id-placeholder
GOOGLE_DRIVE_TOKEN=your-google-drive-token-placeholder
GOOGLE_PROJECT_ID=itissimple-security-staging

# Media Integrations (YouTube & Spotify)
SPOTIFY_TOKEN=your-spotify-token-placeholder
YOUTUBE_API_KEY=your-youtube-api-key-placeholder
